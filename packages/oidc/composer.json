{
    "name": "acta/oidc",
    "description": "OAuth 2.0 and OpenID Connect for PHP 8.5+: Bearer JWT verification with discovery and JWKS for resource servers, and the client flows (client credentials, authorization code with PKCE, device authorization, refresh), on PSR-7, PSR-15, PSR-17 and PSR-18.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "oauth2",
        "oidc",
        "openid-connect",
        "jwt",
        "jwks",
        "bearer",
        "pkce",
        "psr-15",
        "psr-18",
        "resource-server"
    ],
    "require": {
        "php": "^8.5",
        "ext-openssl": "*",
        "psr/clock": "^1.0",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.1",
        "psr/http-message": "^2.0",
        "psr/http-server-handler": "^1.0",
        "psr/http-server-middleware": "^1.0",
        "psr/log": "^3.0",
        "psr/simple-cache": "^3.0",
        "web-token/jwt-library": "^4.1"
    },
    "require-dev": {
        "ext-sodium": "*",
        "friendsofphp/php-cs-fixer": "^3.89",
        "laminas/laminas-diactoros": "^3.8",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.4 || ^13.0"
    },
    "suggest": {
        "ext-sodium": "Required to verify and produce EdDSA signatures.",
        "ext-gmp": "Speeds up signature verification."
    },
    "autoload": {
        "psr-4": {
            "Acta\\Oidc\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Acta\\Oidc\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "check": [
            "@cs",
            "@stan",
            "@test"
        ],
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix",
        "stan": [
            "phpstan analyse --memory-limit=1G",
            "phpstan analyse --memory-limit=1G -c phpstan.tests.neon.dist"
        ],
        "test": "phpunit",
        "test:coverage": "@php -d xdebug.mode=coverage vendor/bin/phpunit --coverage-text"
    },
    "scripts-descriptions": {
        "check": "Runs the coding standard, static analysis and the whole test suite.",
        "stan": "Analyses the library at the max level, then the tests.",
        "cs:fix": "Applies the PER coding style."
    },
    "minimum-stability": "stable"
}
