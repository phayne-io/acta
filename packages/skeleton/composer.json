{
    "name": "acta/skeleton",
    "description": "Project template for hexagonal, event-sourced PHP 8.5+ applications: a contract-first API, a console and webhooks in front of a domain, wired with Mezzio and the Acta libraries.",
    "license": "MIT",
    "type": "project",
    "keywords": [
        "skeleton",
        "hexagonal-architecture",
        "cqrs",
        "event-sourcing",
        "mezzio",
        "openapi",
        "oidc"
    ],
    "require": {
        "php": "^8.5",
        "ext-bcmath": "*",
        "ext-pdo": "*",
        "ext-pdo_pgsql": "*",
        "acta/console-webhook": "^1.0@dev",
        "acta/event-sourcing": "^1.0@dev",
        "acta/http": "^1.0@dev",
        "acta/oidc": "^1.0@dev",
        "guzzlehttp/guzzle": "^7.9 || ^8.0",
        "laminas/laminas-config-aggregator": "^1.21",
        "laminas/laminas-diactoros": "^3.8",
        "laminas/laminas-httphandlerrunner": "^2.13",
        "laminas/laminas-servicemanager": "^4.6",
        "mezzio/mezzio": "^3.29",
        "mezzio/mezzio-fastroute": "^3.14",
        "moneyphp/money": "^4.9",
        "psr/clock": "^1.0",
        "psr/container": "^1.1 || ^2.0",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.1",
        "psr/http-message": "^2.0",
        "psr/http-server-handler": "^1.0",
        "psr/http-server-middleware": "^1.0",
        "psr/log": "^3.0",
        "psr/simple-cache": "^3.0",
        "symfony/cache": "^7.4 || ^8.0",
        "symfony/console": "^7.4 || ^8.0",
        "symfony/yaml": "^7.4 || ^8.0"
    },
    "require-dev": {
        "deptrac/deptrac": "^4.7",
        "friendsofphp/php-cs-fixer": "^3.89",
        "infection/infection": "^0.35",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.4 || ^13.0"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../event-sourcing",
            "options": {
                "versions": {
                    "acta/event-sourcing": "1.0.x-dev"
                }
            }
        },
        {
            "type": "path",
            "url": "../http",
            "options": {
                "versions": {
                    "acta/http": "1.0.x-dev"
                }
            }
        },
        {
            "type": "path",
            "url": "../oidc",
            "options": {
                "versions": {
                    "acta/oidc": "1.0.x-dev"
                }
            }
        },
        {
            "type": "path",
            "url": "../console-webhook",
            "options": {
                "versions": {
                    "acta/console-webhook": "1.0.x-dev"
                }
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "infection/extension-installer": true
        },
        "sort-packages": true
    },
    "scripts": {
        "post-create-project-cmd": [
            "@php -r \"file_exists('.env') || copy('.env.dist', '.env');\""
        ],
        "check": [
            "@cs",
            "@stan",
            "@architecture",
            "@lint:contract",
            "@test"
        ],
        "architecture": "deptrac analyse --no-progress",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix",
        "lint:contract": "@php bin/console openapi:lint",
        "mutation": [
            "@putenv XDEBUG_MODE=coverage",
            "infection --threads=max --no-progress"
        ],
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@php -S 0.0.0.0:8080 -t public"
        ],
        "stan": "phpstan analyse --memory-limit=1G",
        "test": "phpunit",
        "test:unit": "phpunit --exclude-group postgres"
    },
    "scripts-descriptions": {
        "check": "Runs the coding standard, static analysis, the architecture rules, the contract linter and the tests.",
        "architecture": "Checks the dependency rules between layers and contexts.",
        "mutation": "Mutation testing of the domain and the application (needs Xdebug or PCOV).",
        "serve": "Serves the API on http://localhost:8080 with the PHP built-in server."
    },
    "minimum-stability": "stable"
}
