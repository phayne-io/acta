<?php

declare(strict_types=1);

namespace App\{{ Context }}\Infrastructure\Primary\Webhook;

use Acta\Webhook\Exception\UnprocessableWebhook;
use Acta\Webhook\Incoming\IncomingWebhook;
use Acta\Webhook\Incoming\WebhookTranslator;
use Override;

/**
 * Primary adapter: says in the words of the {{ Context }} context what {{ Source }} reports.
 *
 * It is an anti-corruption layer: the payload is the sender's and will change on its
 * schedule; nothing past this class should know its shape. The receiver has already
 * verified the signature and refused duplicates.
 */
final readonly class {{ Source }}Translator implements WebhookTranslator
{
    #[Override]
    public function translate(IncomingWebhook $webhook): iterable
    {
        return match ($webhook->payload['type'] ?? null) {
            // TODO Return the commands each event of interest stands for:
            // 'something.happened' => [new SomeCommand(...)],

            // TODO Acknowledge the events of no interest, or the sender will send them again:
            // 'something.else' => [],

            default => throw new UnprocessableWebhook('This event type is not handled.'),
        };
    }
}
