<?php

declare(strict_types=1);

namespace App\{{ Context }}\Infrastructure\Primary\Webhook;

use Acta\Webhook\Incoming\WebhookSource;
use Acta\Webhook\Signature\StandardWebhooks;
use App\Platform\Container\Resolve;
use App\Platform\Settings;
use Psr\Clock\ClockInterface;
use Psr\Container\ContainerInterface;

/**
 * Declares {{ Source }} as a source of webhooks: its name, how its signature is
 * verified and who translates what it says.
 */
final class {{ Source }}WebhookSource
{
    /** Name of the source: its webhooks are received at `POST /webhooks/{{ source }}`. */
    public const string NAME = '{{ source }}';

    /** Service identifier of the source. */
    public const string ID = '{{ context }}.webhook.{{ source }}';

    public static function create(ContainerInterface $container): WebhookSource
    {
        return new WebhookSource(
            self::NAME,
            // TODO Check how the sender signs. This is the Standard Webhooks scheme; for a signature in a
            // single header, GitHub-style, use Acta\Webhook\Signature\HmacSignature instead.
            new StandardWebhooks(
                Settings::of($container)->string('acta.webhooks.secrets.' . self::NAME),
                clock: Resolve::from($container, ClockInterface::class),
            ),
            new {{ Source }}Translator(),
        );
    }
}
