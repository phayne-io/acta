<?php

declare(strict_types=1);

namespace App\{{ Context }}\Infrastructure\Primary\Http;

use Acta\EventSourcing\Bus\CommandBus;
use Acta\Http\EventSourcing\MessageFactory;
use Acta\Http\EventSourcing\MetadataFactory;
use Acta\Http\Handler\Operation;
use Acta\Http\Response\Responder;
use Acta\Http\Validation\Input;
use App\{{ Context }}\Application\Command\{{ Name }};
use Override;
use Psr\Http\Message\ResponseInterface;
use Psr\Http\Message\ServerRequestInterface;
use Psr\Http\Server\RequestHandlerInterface;

/**
 * Primary adapter: the `{{ name }}` operation of the contract.
 *
 * The request reaches this handler authenticated and validated against
 * `openapi/openapi.yaml`. What is left is to turn it into a command.
 */
#[Operation('{{ name }}')]
final readonly class {{ Name }}Action implements RequestHandlerInterface
{
    public function __construct(
        private CommandBus $commands,
        private MessageFactory $messages,
        private MetadataFactory $metadata,
        private Responder $responder,
    ) {}

    #[Override]
    public function handle(ServerRequestInterface $request): ResponseInterface
    {
        // The path parameters and the fields of the body become the properties of the command.
        $command = $this->messages->create({{ Name }}::class, Input::from($request));

        $this->commands->dispatch($command, $this->metadata->fromRequest($request));

        return $this->responder->empty();
    }
}
