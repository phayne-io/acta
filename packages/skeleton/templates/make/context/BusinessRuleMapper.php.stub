<?php

declare(strict_types=1);

namespace App\{{ Context }}\Infrastructure\Primary\Http;

use Acta\Http\Exception\HttpException;
use Acta\Http\Problem\ExceptionMapper;
use App\{{ Context }}\Domain\Exception\{{ Context }}RuleViolated;
use Override;
use ReflectionClass;
use Throwable;

/**
 * Reports a rule of the {{ Context }} context that was not respected as a 422, with the
 * words of the domain as the detail. The domain itself knows nothing of HTTP.
 */
final readonly class BusinessRuleMapper implements ExceptionMapper
{
    #[Override]
    public function map(Throwable $exception): ?HttpException
    {
        return $exception instanceof {{ Context }}RuleViolated
            ? new HttpException(
                422,
                $exception->getMessage(),
                type: 'urn:problem:{{ context }}:' . self::slug($exception),
                title: 'Business rule violated',
                previous: $exception,
            )
            : null;
    }

    /**
     * Turns the class name of a rule into a stable identifier clients can test.
     */
    private static function slug({{ Context }}RuleViolated $exception): string
    {
        return new ReflectionClass($exception)->getShortName()
            |> (static fn(string $name): string => (string) preg_replace('/(?<!^)[A-Z]/', '-$0', $name))
            |> strtolower(...);
    }
}
