# Settings of the application. Copy to .env: Docker Compose and the Makefile read it.
# Without Docker, export these variables or override them in config/autoload/local.php.

# What the project is called. `composer create-project` asks for these three; the local
# stack derives everything else from them: the name of the containers and of the Keycloak
# realm, and the two addresses https://api.<APP_DOMAIN> and https://auth.<APP_DOMAIN>.
COMPOSE_PROJECT_NAME=mybank
APP_NAME=MyBank
APP_DOMAIN=mybank.io

APP_DEBUG=1

# PostgreSQL
DATABASE_DSN=pgsql:host=database;port=5432;dbname=app
DATABASE_USER=app
DATABASE_PASSWORD=app

# Valkey (or Redis), where the metadata and the keys of the identity provider are kept.
# Empty: files under data/cache, which each machine then fills on its own.
CACHE_DSN=redis://cache:6379

# The ports PostgreSQL and Valkey are published on, for the tools of this machine.
DATABASE_PORT=54320
CACHE_PORT=63790

# Read models brought up to date after each command, for a machine without projection
# workers. Docker Compose runs the workers: leave empty there and in production.
PROJECTIONS_AFTER_COMMAND=

# "fail" turns a response that breaks the contract into a 500; "log" in production.
HTTP_RESPONSE_VALIDATION=fail

# The identity provider (OpenID Connect) and the identifier of this API in its tokens.
OIDC_ISSUER=https://auth.${APP_DOMAIN}/realms/${COMPOSE_PROJECT_NAME}
OIDC_AUDIENCE=${COMPOSE_PROJECT_NAME}-api
OIDC_ALLOW_INSECURE=0
OIDC_CLIENT_ID=${COMPOSE_PROJECT_NAME}-console

# Secrets shared with the senders of incoming webhooks, in the Standard Webhooks form.
WEBHOOK_PAYMENTS_SECRET=whsec_Y2hhbmdlLW1lLWluLXByb2R1Y3Rpb24=
# acta:webhook-secrets

LOG_LEVEL=info
