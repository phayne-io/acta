# TLS for the two names of the application, with the certificate `make certs` writes.
# The nginx image replaces ${APP_DOMAIN} when it starts, and nothing else: it only knows
# the variables of its environment, so the variables of nginx itself are left alone.

ssl_certificate /etc/nginx/certs/local.pem;
ssl_certificate_key /etc/nginx/certs/local-key.pem;
ssl_protocols TLSv1.2 TLSv1.3;

# Docker's resolver: lets nginx start, and keep running, while Keycloak is away.
resolver 127.0.0.11 valid=10s;

server {
    listen 80 default_server;
    server_name _;

    return 301 https://$host$request_uri;
}

# The API: every request goes to the front controller, public/index.php, through PHP-FPM.
server {
    listen 443 ssl default_server;
    http2 on;
    server_name api.${APP_DOMAIN};
    root /app/public;

    # Incoming webhooks are refused beyond 1 MB by the application itself.
    client_max_body_size 2m;

    location / {
        try_files $uri /index.php$is_args$args;
    }

    location = /index.php {
        set $php api:9000;
        fastcgi_pass $php;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME /app/public/index.php;
        fastcgi_param DOCUMENT_ROOT /app/public;
        fastcgi_param HTTPS on;
        # PHP does not see the Authorization header unless it is passed explicitly.
        fastcgi_param HTTP_AUTHORIZATION $http_authorization;
        internal;
    }

    location ~ \.php$ {
        return 404;
    }
}

# Keycloak, which listens in plain HTTP behind this proxy.
server {
    listen 443 ssl;
    http2 on;
    server_name auth.${APP_DOMAIN};

    # Keycloak answers with large headers (cookies, redirects carrying tokens).
    proxy_buffer_size 128k;
    proxy_buffers 4 256k;
    proxy_busy_buffers_size 256k;

    location / {
        set $keycloak http://keycloak:8080;
        proxy_pass $keycloak;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port 443;
    }
}
